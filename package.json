{
  "name": "vscode-treefmt-nix",
  "version": "1.0.2",
  "description": "Format files using treefmt-nix",
  "categories": [
    "Formatters",
    "Other"
  ],
  "repository": {
    "url": "https://github.com/VanCoding/vscode-treefmt-nix"
  },
  "publisher": "VanCoding",
  "files": [
    "dist/**",
    "LICENSE.md",
    "logo.png"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "test": "tsgo --noEmit && treefmt --fail-on-change && oxlint",
    "build": "npm run test && rolldown -c rolldown.config.ts",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --out extension.vsix",
    "install-extension": "npm run package && code --install-extension extension.vsix"
  },
  "devDependencies": {
    "@types/node": "~26.4.1",
    "@types/vscode": "1.90.0",
    "rolldown": "1.2.7"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.runTreefmt",
        "title": "Run Treefmt"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "./logo.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "configuration": [
    {
      "title": "treefmt",
      "properties": {}
    }
  ]
}
